# Example nginx.conf với keep_connections feature

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    
    server {
        listen 80;
        location / {
            root /var/www/html;
        }
    }
}

rtmp {
    server {
        listen 1935;
        
        application live {
            # Bật live streaming
            live on;
            
            # Bật tính năng keep connections
            keep_connections on;
            
            # Thời gian chờ publisher reconnect (30 giây)
            reconnect_timeout 30s;
            
            # Các cấu hình khác cho production
            
            # Chờ keyframe trước khi gửi cho subscriber mới
            wait_key on;
            
            # Cho phép publish từ mọi nơi (chỉ để test)
            allow publish all;
            
            # Cho phép play từ mọi nơi
            allow play all;
            
            # Ghi log
            access_log /var/log/nginx/rtmp_access.log;
            
            # HLS output (optional)
            hls on;
            hls_path /tmp/hls;
            hls_fragment 3;
            hls_playlist_length 60;
            
            # DASH output (optional)  
            dash on;
            dash_path /tmp/dash;
            dash_fragment 3;
            dash_playlist_length 60;
        }
        
        # Application khác không dùng keep_connections
        application record {
            live on;
            
            # Tính năng keep_connections tắt (mặc định)
            keep_connections off;
            
            # Record streams
            record all;
            record_path /tmp/recordings;
            record_suffix .flv;
        }
    }
}
